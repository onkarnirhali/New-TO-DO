# ── Server ────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── Database ─────────────────────────────────────────────────────────
# Local Docker Postgres (for development)
DATABASE_URL=postgresql://planote:planote_dev@localhost:5432/planote

# ── Redis ─────────────────────────────────────────────────────────────
# Local Docker Redis (for development)
REDIS_URL=redis://localhost:6379

# ── Clerk ─────────────────────────────────────────────────────────────
# The API uses this to verify JWT tokens issued by Clerk
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...

# ── CORS ──────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000

# ── Cloudflare R2 (file storage) ──────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=planote-dev

# ── AI Services (added in Milestone 18) ───────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_CLOUD_API_KEY=
